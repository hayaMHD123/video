# Optional: Gemini can help draft episode plans and image prompts.
GEMINI_API_KEY=

# Optional: free reference-based image generation in the separate character tab.
# Create a Workers AI API token and Account ID in the Cloudflare dashboard.
# Keep all three values server-only; set them in Vercel Environment Variables.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CHARACTER_STUDIO_PASSWORD=

# Optional: a locally installed Ollama model; no cloud account or API bill.
OLLAMA_MODEL=

# Optional: direct upload to your own YouTube channel from this local app.
# Create a Google OAuth 2.0 Client ID of type "Web application".
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:3000/api/youtube/callback
